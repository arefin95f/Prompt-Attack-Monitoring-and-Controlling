# SecureAI API — copy to .env and fill values before going live.
# Never commit a real .env.

# Required for Lab / admin routes
ADMIN_INTERNAL_TOKEN=change-me-to-a-long-random-secret

# Public CORS origins (comma-separated). Chat + admin frontends.
# Example live:
# CORS_ORIGINS=https://chat.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Optional Layer 4 LLM judge (OpenRouter)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
